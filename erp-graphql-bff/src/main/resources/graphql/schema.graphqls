# Northwood GraphQL BFF schema.
#
# Field names mirror the real service view records 1:1 (verified against
# sales/product/inventory/reporting *View records). Scalar-typed fields use the
# graphql-java extended scalars registered in ScalarConfig.
#
# Resolution map (which backend answers each type):
#   Query.salesOrders        -> reporting GET /api/sales-orders   (SalesOrder360View)
#   Query.salesOrder(id)     -> sales     GET /api/sales-orders/{id} (SalesOrderView, has lines)
#   Query.products / product -> product   GET /api/products[/{id}]
#   Query.customer(id)       -> sales     GET /api/customers/{id}
#   SalesOrder.customer      -> sales     GET /api/customers     (batched by customerId)
#   SalesOrderLine.product   -> product   GET /api/products      (batched by productId)
#   Product.stock            -> inventory GET /api/stock-items   (batched by productId)
#   Product.atp              -> reporting GET /api/atp           (batched by productId)
#   Mutation.placeOrder      -> sales     POST /api/sales-orders
#   Subscription.events      -> live *.events Kafka feed (kafka profile only)

scalar BigDecimal
scalar Date          # java.time.LocalDate
scalar DateTime      # java.time.OffsetDateTime

type Query {
  salesOrders: [SalesOrderSummary!]!
  salesOrder(id: ID!): SalesOrder
  products: [Product!]!
  product(id: ID!): Product
  customer(id: ID!): Customer
  search(q: String, type: String): GlobalSearchResult!   # search-service GET /api/search (read model B)
}

type SalesOrder {                        # source: sales SalesOrderView
  id: ID!
  orderNumber: String!
  orderDate: Date
  requestedDeliveryDate: Date
  status: String
  currencyCode: String
  subtotalAmount: BigDecimal
  taxAmount: BigDecimal
  totalAmount: BigDecimal
  paymentTerms: String
  customer: Customer                     # resolved from customerId -> batch loader
  lines: [SalesOrderLine!]!              # embedded in SalesOrderView.lines
}

type SalesOrderLine {                    # source: sales SalesOrderLineView
  lineId: ID!
  lineNumber: Int
  productSku: String
  orderedQuantity: BigDecimal
  reservedQuantity: BigDecimal
  shippedQuantity: BigDecimal
  backorderedQuantity: BigDecimal
  unitPrice: BigDecimal
  lineTotal: BigDecimal
  lineStatus: String
  product: Product                       # resolved from productId -> batch loader (N+1 hotspot)
}

type Product {                           # source: product ProductView
  id: ID!
  sku: String!
  name: String
  description: String
  productType: String
  salesPrice: BigDecimal
  standardCost: BigDecimal
  status: String
  stock: StockItem                       # resolved from productId -> inventory batch loader
  atp: AvailableToPromise                # resolved from productId -> reporting batch loader
}

type StockItem {                         # source: inventory StockItemView
  productId: ID!
  productSku: String
  productName: String
  onHand: BigDecimal
  reserved: BigDecimal
  available: BigDecimal
  reorderPoint: BigDecimal
}

type AvailableToPromise {                # source: reporting AvailableToPromiseView
  productId: ID!
  onHandQuantity: BigDecimal
  reservedForSales: BigDecimal
  reservedForProduction: BigDecimal
  availableQuantity: BigDecimal
  incomingFromProduction: BigDecimal
  incomingFromPurchase: BigDecimal
  earliestAvailableDate: Date
  stockStatus: String
}

type Customer {                          # source: sales CustomerView
  id: ID!
  customerCode: String
  name: String
  email: String
  phone: String
  status: String
  defaultPaymentTerms: String
  billingAddress: String
  shippingAddress: String
}

type GlobalSearchResult {                # source: search-service GlobalSearchResults (read model B)
  totalHits: Int!
  hits: [EntityHit!]!
  entityTypeFacets: [FacetBucket!]!      # counts per entity type, for a "filter by type" UI
}

type EntityHit {                         # one hit, any bounded context
  entityType: String!                    # product / customer / sales_order / supplier / purchase_order / customer_invoice
  entityId: ID!
  title: String                          # display name / document number
  code: String                           # sku / customer code / order or PO / invoice number
  subtitle: String                       # email / counterparty / product type
  status: String
  score: Float                           # Elasticsearch relevance score
  # Live drill-downs: ES finds the hit (stale-tolerant), these hydrate the FRESH
  # authoritative record from the owning service. Non-null only for the matching
  # entityType; product/customer are DataLoader-batched (one upstream call each).
  product: Product                       # when entityType = product   -> product GET /api/products/{id} (+ live stock/atp)
  salesOrder: SalesOrder                 # when entityType = sales_order -> sales GET /api/sales-orders/{id}
  customer: Customer                     # when entityType = customer  -> sales GET /api/customers/{id}
}

type FacetBucket {
  key: String!
  count: Int!
}

type SalesOrderSummary {                 # source: reporting SalesOrder360View (list, no lines)
  salesOrderHeaderId: ID!
  orderNumber: String!
  customerName: String
  orderStatus: String
  totalAmount: BigDecimal
  outstandingAmount: BigDecimal
  hasShortage: Boolean
}

type Mutation {
  placeOrder(input: PlaceOrderInput!): SalesOrder    # POST sales /api/sales-orders
}

input PlaceOrderInput {
  orderNumber: String!
  customerCode: String!                  # NB: command keys on customerCode, not customerId
  currencyCode: String!
  requestedDeliveryDate: Date
  paymentTerms: String
  depositPercent: BigDecimal
  lines: [PlaceOrderLineInput!]!
}
input PlaceOrderLineInput {
  productId: ID!
  productSku: String!
  productName: String!
  orderedQuantity: BigDecimal!
  unitPrice: BigDecimal
  taxRate: BigDecimal
}

type Subscription {
  # Live *.events Kafka feed. Optional filters narrow the stream so a client can
  # watch just what it cares about (e.g. only product events, or one aggregate
  # type) — the same fan-out that drives the ES + Redis read-side reactions.
  events(aggregateType: String, eventType: String, sourceService: String): DomainEvent!
}
type DomainEvent {
  eventId: ID!
  eventType: String!
  sourceService: String!
  aggregateType: String
  aggregateId: ID
  occurredAt: DateTime
}
